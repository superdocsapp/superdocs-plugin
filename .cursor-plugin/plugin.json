{
  "$schema": "https://raw.githubusercontent.com/cursor/plugins/main/schemas/plugin.schema.json",
  "name": "superdocs",
  "displayName": "Typebar (formerly SuperDocs)",
  "version": "1.3.0",
  "description": "Typebar (formerly SuperDocs), the document harness for your AI: a structured-document editor for AI agents. 38 MCP tools for section-precise edits with table/border/font preservation, multi-format export, pre-signed URL upload/download. Exports .docx, PDF, HTML, Markdown, plain text; ingests .pdf, .docx, .txt, .rtf, .md, .html, .htm.",
  "author": {
    "name": "Typebar",
    "email": "hello@superdocs.app"
  },
  "homepage": "https://docs.typebar.ai",
  "repository": "https://github.com/superdocsapp/superdocs-plugin",
  "license": "MIT",
  "keywords": [
    "document",
    "docx",
    "pdf",
    "editing",
    "mcp",
    "ai",
    "typebar",
    "superdocs",
    "structural-editing",
    "contract",
    "nda",
    "templates"
  ],
  "skills": "./skills/",
  "commands": [
    "commands/superdocs-setup.md"
  ],
  "mcpServers": {
    "superdocs": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://api.superdocs.app/mcp/",
        "--header",
        "Authorization: Bearer ${SUPERDOCS_API_KEY}"
      ],
      "env": {
        "SUPERDOCS_API_KEY": "${SUPERDOCS_API_KEY}"
      }
    }
  }
}
